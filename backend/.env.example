# Backend settings: copy to .env and pass --env-file .env explicitly.
# Phase 4 can reuse the existing Hermes OpenAI/Codex credential; no new key is needed.
# Optional OPENAI_API_KEY and EPOCH_HERMES_HOME/EPOCH_HERMES_CHECKOUT belong in
# the process environment, not this file. See docs/DEBUGGER_SETUP.md.
# Luna and the 20-turn/600-second limits do not require environment variables.
# Phase 5 repair needs Linux Docker plus this pinned image pulled during setup.
# Optional: omit this setting to use the same default. Runtime never pulls images.
EPOCH_REPAIR_IMAGE=python:3.12-slim@sha256:78387bc3881b8273120a12ebe6c1ab22b018ccc2c9adf565ae1ac9b536e184ea
EPOCH_HOST=127.0.0.1
EPOCH_PORT=8000
EPOCH_LOG_LEVEL=info
EPOCH_ENABLE_HERMES=true
# OPTIONAL app-file setting; process environment overrides it. Default: 300 seconds.
# Keep one idle Hermes worker for the same conversation; 0 disables reuse (max 3600).
# No new credential or data directory. See docs/CHAT_LATENCY.md.
EPOCH_CHAT_WORKER_IDLE_SECONDS=300
# Incident projection is local; Luna analysis runs only after an explicit request.
# Built-in Hermes chat uses Neatlogs and local SQLite automatically; no token needed.
# External SDK HTTP ingestion requires EPOCH_TELEMETRY_TOKEN in the PROCESS environment.
# See docs/CHAT_TRACES.md for the chat -> trace flow and manual acceptance.
# Normal startup: epoch-backend --env-file .env serve (chat + debugger + traces).
# Reuse the existing EPOCH_DATA_DIR to retain the same conversations and workflow state.
# Optional trace-only profile: serve --profile trace-debugger; it omits chat/repairs.
# That optional profile requires cloud forwarding false; normal serve honors the setting below.
# For external ingestion, keep EPOCH_TELEMETRY_TOKEN process-only in collector and SDK.
# Capture/browsing needs no model or cloud key. See docs/TRACE_EXPLORER.md.
EPOCH_TELEMETRY_ENABLED=true
# OPTIONAL app-file settings for Phase 3 questions; these are also the defaults.
# Only asking a question calls Ollama. No model is installed or downloaded for you.
# Use the exact locally installed model name. No Ollama or Neatlogs cloud key needed.
# See docs/TRACE_QUESTIONS.md for setup and manual acceptance instructions.
EPOCH_OLLAMA_BASE_URL=http://127.0.0.1:11434
EPOCH_TRACE_MODEL=qwen3:4b-instruct-2507-q4_K_M
EPOCH_TRACE_QUESTION_TIMEOUT_SECONDS=180
# Noise investigation reuses these Ollama settings; no additional key/setting is required.
# Documents Review cleanup / Apply filter / Undo needs no new setting or migration.
# Keep this data directory and existing credentials; see docs/DATA_NOISE_DEMO.md.
# Normal serve adds context-policies.sqlite3 inside this same EPOCH_DATA_DIR.
# Documents filters apply after explicit source review; the separate trial route requires four trials.
# See docs/NOISE_WORKFLOW.md. Hermes chat/trials retain their existing model provider.
# Optional external/native cloud forwarding requires NEATLOGS_API_KEY here or in process.
# Built-in chat SDK spans always stay local, even when legacy forwarding is enabled.
# Process environment values take precedence. Never commit a real key.
EPOCH_NEATLOGS_CLOUD_ENABLED=false
NEATLOGS_API_KEY=
EPOCH_DATA_DIR=data
EPOCH_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# Phases 6/7 use these same settings; no new credentials or environment variables.
# Development was delivered without running tests; see docs/PHASES_6_7_HANDOFF.md.

# PDF workshop requires the local image built by scripts/setup_pdf_runtime.py.
# Uploads require Docker Desktop's local Linux engine to be running; readiness is checked before container creation.
# Multiple PDF uploads and safe explicit retry need no new settings. See docs/PDF_UPLOADS.md.
# OPTIONAL app-file setting. Omit to use EPOCH_DATA_DIR/pdf/runtime.json.
# Set only an immutable sha256 image identity, never a mutable tag.
EPOCH_PDF_IMAGE_ID=
