{
  "description": "Phase 7 generated artifact proposals, rollback requests and host repair limits; Phases 6 and 7 untested.",
  "models": {
    "GeneratedToolContract": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "maxLength": 1500,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "input_schema_json": {
          "maxLength": 12000,
          "minLength": 2,
          "title": "Input Schema Json",
          "type": "string"
        },
        "name": {
          "const": "directory.lookup_qa_owner",
          "title": "Name",
          "type": "string"
        },
        "output_schema_json": {
          "maxLength": 12000,
          "minLength": 2,
          "title": "Output Schema Json",
          "type": "string"
        }
      },
      "required": [
        "name",
        "description",
        "input_schema_json",
        "output_schema_json"
      ],
      "title": "GeneratedToolContract",
      "type": "object"
    },
    "RepairLimits": {
      "additionalProperties": false,
      "properties": {
        "guaranteed_usd_cap": {
          "default": null,
          "title": "Guaranteed Usd Cap",
          "type": "null"
        },
        "inference_cost_unit": {
          "const": "authorized_model_request",
          "default": "authorized_model_request",
          "title": "Inference Cost Unit",
          "type": "string"
        },
        "max_attempts": {
          "const": 2,
          "default": 2,
          "title": "Max Attempts",
          "type": "integer"
        },
        "max_model_requests": {
          "const": 60,
          "default": 60,
          "title": "Max Model Requests",
          "type": "integer"
        },
        "max_wall_seconds": {
          "const": 1800,
          "default": 1800,
          "title": "Max Wall Seconds",
          "type": "integer"
        },
        "verification_max_seconds": {
          "const": 600,
          "default": 600,
          "title": "Verification Max Seconds",
          "type": "integer"
        },
        "verification_max_turns": {
          "const": 20,
          "default": 20,
          "title": "Verification Max Turns",
          "type": "integer"
        }
      },
      "title": "RepairLimits",
      "type": "object"
    },
    "RepairProposal": {
      "$defs": {
        "GeneratedToolContract": {
          "additionalProperties": false,
          "properties": {
            "description": {
              "maxLength": 1500,
              "minLength": 1,
              "title": "Description",
              "type": "string"
            },
            "input_schema_json": {
              "maxLength": 12000,
              "minLength": 2,
              "title": "Input Schema Json",
              "type": "string"
            },
            "name": {
              "const": "directory.lookup_qa_owner",
              "title": "Name",
              "type": "string"
            },
            "output_schema_json": {
              "maxLength": 12000,
              "minLength": 2,
              "title": "Output Schema Json",
              "type": "string"
            }
          },
          "required": [
            "name",
            "description",
            "input_schema_json",
            "output_schema_json"
          ],
          "title": "GeneratedToolContract",
          "type": "object"
        }
      },
      "additionalProperties": false,
      "properties": {
        "diagnosis": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Diagnosis",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "maxItems": 10,
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        },
        "outcome": {
          "enum": [
            "repair",
            "unsupported"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "source": {
          "maxLength": 20000,
          "title": "Source",
          "type": "string"
        },
        "target": {
          "enum": [
            "checklist_serializer.py",
            "qa_lookup.py",
            "runbook_selector.py"
          ],
          "title": "Target",
          "type": "string"
        },
        "tool_contract": {
          "anyOf": [
            {
              "$ref": "#/$defs/GeneratedToolContract"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "uncertainty": {
          "maxLength": 2000,
          "title": "Uncertainty",
          "type": "string"
        }
      },
      "required": [
        "outcome",
        "diagnosis",
        "evidence_ids",
        "target",
        "source",
        "uncertainty"
      ],
      "title": "RepairProposal",
      "type": "object"
    },
    "RollbackRequest": {
      "additionalProperties": false,
      "properties": {
        "client_request_id": {
          "format": "uuid",
          "title": "Client Request Id",
          "type": "string"
        },
        "expected_version": {
          "format": "uuid",
          "title": "Expected Version",
          "type": "string"
        }
      },
      "required": [
        "client_request_id",
        "expected_version"
      ],
      "title": "RollbackRequest",
      "type": "object"
    }
  },
  "schema_version": 1
}
